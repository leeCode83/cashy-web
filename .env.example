# zkTLS verification (Reclaim Protocol) environment — copy to `.env.local` for
# local dev and mirror the same keys in Vercel → Settings → Environment
# Variables. Never commit real values: `.env.local` is gitignored, this file
# only documents the key names.

# Reclaim dashboard → app credentials.
RECLAIM_APP_ID=
# Secret — server-side only, must never reach the browser bundle.
RECLAIM_APP_SECRET=
# Custom provider that scrapes the mock AdSense page (see mock-adsense/README.md).
RECLAIM_PROVIDER_ID=
# Public URL of the deployed mock-adsense/ page (second Vercel project).
MOCK_ADSENSE_URL=
